  "operations": [
    {
      "id": "stoichiometric_flow",
      "inputs": [
        "Jp",
        "Jgr",
        "Jreg",
        "Jg"
      ],
      "outputs": [
        "Gdot",
        "Odot",
        "Ndot",
        "Pdot"
      ],
      "equations": [
        "Gdot=-2Jp+2Jgr+Jg",
