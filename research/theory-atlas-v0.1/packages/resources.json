      ],
      "duration": "[0,T] while pools remain nonnegative",
      "admissibility": "absolutely continuous species; measurable integrable fluxes"
    },
    {
      "id": "induction",
      "equation": "tau*adot=s-a; 0<=s<=1; a(0)=0",
